# Amazon Bedrock (optional) — use with MODEL_NAME=bedrock/...
# See docs/getting-started/bedrock.md for model IDs and auth choices.
# Auth A (quick dev): Bedrock API key (bearer token)
#AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
# Auth B (production/CI): standard AWS credentials (SigV4). SSO users can export
# a session with: eval "$(aws configure export-credentials --profile <p> --format env)"
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#AWS_REGION_NAME=us-east-1

