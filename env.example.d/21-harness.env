# Context harness (docs/architecture/harness_engineering.md). Budgets derive
# from the model's context window (MODEL_CONTEXT_WINDOW or LiteLLM's model map).
#DAK_CONTEXT_HARNESS=true
#DAK_COMPACTION_THRESHOLD_RATIO=0.6   # compact older events past 60% of the window
#DAK_COMPACTION_RETAIN_EVENTS=4       # newest events kept verbatim
#DAK_COMPACTION_INPUT_RATIO=0.5       # history per summary request; the rest is for the summary
#DAK_REQUEST_BUDGET_RATIO=0.85        # last-resort trim of old tool payloads
#DAK_MODEL_ERROR_RETRY_ATTEMPTS=2     # retries (halving the budget) when the model still rejects a request for size
#DAK_TOOL_OUTPUT_MAX_CHARS=           # default: 15% of the window (2K..40K chars)
#DAK_MAX_REPEATED_TOOL_CALLS=3        # same tool + args in a row beyond this is answered with a "repeated_call" observation
#DAK_MAX_TOOL_CALLS=40                # tool calls per invocation beyond this get "step_limit_exceeded"
#DAK_MAX_WALL_SECONDS=300             # tool calls this long after the invocation's first one get "wall_time_exceeded"

